{
  "expo": {
    "name": "Doubleday",
    "slug": "doubleday",
    "version": "1.0.0",
    "scheme": "doubleday",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appleforge.doubleday"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.appleforge.doubleday"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ]
  }
}
